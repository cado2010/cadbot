# Copy to .env (Git ignores it) and fill in. Never commit the real file.
# On the Raspberry Pi the same keys go in /etc/cadbot/secrets.env (mode 600).

# From the Claude Console. Set a monthly spend limit there before first use.
ANTHROPIC_API_KEY=

# Optional: an Admin API key (sk-ant-admin01-..., from platform.claude.com/settings/admin-keys;
# individual accounts must first set up an organization at /settings/organization) lets
# `python -m cadbot.admin spend` show what Anthropic billed for cadbot's key. It is never used
# by the running assistant. Leave it out if you don't need billed figures.
# ANTHROPIC_ADMIN_KEY=

# Optional: force a platform (windows, pi or fake). Auto-detected when unset.
# CADBOT_PLATFORM=windows
